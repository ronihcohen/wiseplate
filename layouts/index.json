{{- $pages := slice -}}
{{- range .Site.Pages -}}
  {{- if .OutputFormats.Get "HTML" -}}
    {{- $terms := slice .Title (.Params.seo_title | default "") (.Description | default "") .RelPermalink -}}
    {{- range .Params.tags -}}{{- $terms = $terms | append . -}}{{- end -}}
    {{- range .Params.keywords -}}{{- $terms = $terms | append . -}}{{- end -}}
    {{- $pages = $pages | append (dict "title" .Title "url" .RelPermalink "terms" $terms) -}}
  {{- end -}}
{{- end -}}
{{- $pages | jsonify -}}
