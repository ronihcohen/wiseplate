{{- /* Mirrors Hugo's internal sitemap template, minus thin taxonomy terms.
       A term page below min_term_pages is a title plus one or two links, with
       the site-default description — nothing worth submitting for indexing.
       Trim markers matter here: the XML declaration must start byte 0. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- $min := site.Params.min_term_pages | default 5 -}}
  {{- range .Pages -}}
    {{- if and .Permalink (not (and (eq .Kind "term") (lt (len .Pages) $min))) }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
  </url>
    {{- end -}}
  {{- end }}
</urlset>
